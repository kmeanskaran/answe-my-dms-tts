# Atoms API key for KB management endpoints
SMALLEST_API_KEY=

# Atoms API base for KB REST operations
SMALLEST_ATOMS_BASE_URL=

# Optional: attach an existing Atoms Knowledge Base ID to agent context metadata
SMALLEST_KB_ID=

# Optional: local markdown/txt file to inject as lightweight KB context
KB_CONTEXT_FILE=

# Provider switch (set true for local Ollama)
USE_OLLAMA=

# Ollama config
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Non-Ollama config (OpenAI-compatible endpoint)
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_API_KEY=

# Smallest TTS config
SMALLEST_BASE_URL=
SMALLEST_TTS_PATH=
SMALLEST_SAMPLE_RATE=
SMALLEST_OUTPUT_FORMAT=
SMALLEST_VOICE_ID=
SMALLEST_ATOM_VOICE_ID=
SMALLEST_SPEED=
